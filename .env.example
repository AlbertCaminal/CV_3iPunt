# Copia este archivo como `.env` y rellena los valores que apliquen.
# El archivo `.env` está en `.gitignore`.

# URL absoluta donde se desplegará la web (sin barra final).
# Se usa para los meta tags Open Graph (og:url, og:image) y JSON-LD.
VITE_SITE_URL=https://albert-caminal.vercel.app

# Plausible Analytics (opcional).
# Si dejas la variable vacía o no la pones, NO se carga ningún script externo.
# Registra tu dominio en https://plausible.io y ponlo aquí (sin protocolo).
# VITE_PLAUSIBLE_DOMAIN=albert-caminal.vercel.app
# VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.js
